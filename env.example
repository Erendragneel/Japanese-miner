# Public application location. For GitHub Pages include the repository path and trailing slash.
APP_URL=https://YOUR_GITHUB_NAME.github.io/YOUR_REPOSITORY/
ALLOWED_ORIGINS=https://YOUR_GITHUB_NAME.github.io

# Patreon API v2 application and campaign values.
PATREON_CLIENT_ID=replace-with-client-id
PATREON_CLIENT_SECRET=replace-with-client-secret
PATREON_CAMPAIGN_ID=replace-with-campaign-id
PATREON_CREATOR_ACCESS_TOKEN=replace-with-creator-access-token
PATREON_WEBHOOK_SECRET=replace-with-webhook-secret

# Use the immutable Patreon IDs, not the tier prices or titles.
PATREON_TIER_1_ID=replace-with-supporter-tier-id
PATREON_TIER_2_ID=replace-with-companion-keeper-tier-id
PATREON_TIER_3_ID=replace-with-settlement-founder-tier-id

PATREON_OFFLINE_GRACE_DAYS=7
PATREON_USER_AGENT=Japanese Miner - Membership Linking

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied automatically by hosted Edge Functions.
